#!/bin/bash
# Pre commit hook

# Update last modified label on Dockerfiles
DOCKERFILE=$(git status | grep modified | grep Dockerfile | awk '{print $2}' | xargs)
if [ "$DOCKERFILE" ] ; then
    echo "Found some Dockerfile modified, updating LABELS..." 
    # cycle on the Dockerfile updating LABELs line
    for f in $DOCKERFILE; do
        echo "  > Updating last_modified on file $f"
        sed s/"^.*last_modified.*$"/"LABEL last_modified=\"$(date +%Y-%m-%d)\""/ -i $f
    done
else
    # no dockerfile modified
    echo "No dockerfile modified to update last_modified label"
fi

# Get the list of modified files, to get only executables
EXECS=$(git status | grep modified | grep -v Dockerfile | awk '{print $2}' | xargs)
for f in $EXECS; do
    # check if the file is executable
    if [ -x $f ] ; then
        # Update the Copyright line
        echo "  > Updating Copyright on executable file $f"
        sed s/"^# Copyright.*Pavel Milanes.*$"/"# Copyright 2020-$(date +%Y) Pavel Milanes Costa <pavelmc@gmail.com>"/ -i $f
    fi
done
