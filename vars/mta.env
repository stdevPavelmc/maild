# Debug comment to disable
#MTA_DEBUG=1

# bytes ~1024 * 1024 * MB * 1.33; by default ~25M
# 25 MB | MAX_MESSAGESIZE=2264924
#
# If you need more just set it up on the production .env file
# it has preference there and this valus will be ignored 
MAX_MESSAGESIZE=34865152

# external relay
#RELAY=

# backgroun carbon copy, must be a valid email 
#ALWAYS_BCC=

# enable SPF checking
SPF_ENABLE=True

# enable DNS Black Listing
DNSBL_ENABLE=true
DNSBL_LIST="zen.spamhaus.org=127.0.0.[2..11]*2,psbl.surriel.com,bl.spamcop.net,bl.spameatingmonkey.net"

# point the abuse and postmaster address of each domain to the sysadmins address
# Disabled by default, we do that on the admin interface
# POSTMASTER_ABUSE_SETUP=true

# First-boot provisioning gate (waits for the maild_provision sentinel before the virtual aliases)
AUTO_PROVISION=${AUTO_PROVISION:-yes}
PROVISION_VERSION=${PROVISION_VERSION:-1}
PROVISION_WAIT_TIMEOUT=${PROVISION_WAIT_TIMEOUT:-180}

##### Do not edit below this line ##############
AMAVIS=amavis
MDA=mda
MUA=MUA
ADMIN=admin
