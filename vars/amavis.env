# debug uncomment to enable
#AMAVIS_DEBUG=1

# hostname of the mta to deliver emails back
AMAVIS_MTA=mta

# spam checking, comment to disable
SPAM_FILTER_ENABLED=yes

# AV, commment to disable
AV_ENABLED=yes

# DKIM, comment to disable
DKIM_SIGNING=yes

# First-boot provisioning gate (waits for the maild_provision sentinel before DKIM setup)
AUTO_PROVISION=${AUTO_PROVISION:-yes}
PROVISION_VERSION=${PROVISION_VERSION:-1}
PROVISION_WAIT_TIMEOUT=${PROVISION_WAIT_TIMEOUT:-180}

##### Do not edit below this line ##############
CLAMAV=clamav
MTA=mta
CRON=cron

##### SpamAssassin learning & maintenance (read by amavis, cron & mda) #####

# days to keep messages on the user's Junk folders before purging them,
# set to 0 to disable the purge
JUNK_RETENTION_DAYS=7

# ham learning: random INBOX sample size per mailbox and global cap per run
SA_HAM_SAMPLE_PER_USER=25
SA_HAM_SAMPLE_MAX=400

# bayes autolearn thresholds for the normal scans (amavis)
SA_AUTOLEARN_NONSPAM=0.1
SA_AUTOLEARN_SPAM=10

# optional overrides
#SA_BAYES_PATH=/var/lib/spamassassin/bayes/db
#SA_UPDATE_HOUR=2
#SA_UPDATE_MINUTE=50
