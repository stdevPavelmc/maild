# First-boot provisioning — the admin container is the leader (see .agents/services/provisioning.md)
AUTO_PROVISION=${AUTO_PROVISION:-yes}
MAIL_ADMIN_PASSWORD=${MAIL_ADMIN_PASSWORD:-}
PROVISION_VERSION=${PROVISION_VERSION:-1}
PROVISION_WAIT_TIMEOUT=${PROVISION_WAIT_TIMEOUT:-180}
PROVISION_FORCE=${PROVISION_FORCE:-no}

##### Do not edit below this line ##############
POSTFIXADMIN_DB_TYPE=pgsql
POSTFIXADMIN_SMTP_SERVER=mta
POSTFIXADMIN_SMTP_PORT=25
