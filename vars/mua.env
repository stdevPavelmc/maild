BANNER_TITLE=Webmail
#MUA_DEBUG=1

## o not modify below this line
MTA=mta
MDA=mda

###### DO not edi below this line #######
# First-boot provisioning gate (waits for the maild_provision sentinel before the per-domain configs)
AUTO_PROVISION=${AUTO_PROVISION:-yes}
PROVISION_VERSION=${PROVISION_VERSION:-1}
PROVISION_WAIT_TIMEOUT=${PROVISION_WAIT_TIMEOUT:-180}

# SnappyMail configuration + admin panel (see env.sample): the login defaults to `maild`, the
# password is generated and printed on the first boot (MUA_ADMIN_PASSWORD forces a known one)
MUA_ADMIN_USER=${MUA_ADMIN_USER:-maild}
MUA_ADMIN_PASSWORD=${MUA_ADMIN_PASSWORD:-}
MUA_CONFIG_WAIT_TIMEOUT=${MUA_CONFIG_WAIT_TIMEOUT:-120}

# SnappyMail plugins installed from the image and kept enabled (see env.sample)
MUA_PLUGINS=${MUA_PLUGINS:-add-x-originating-ip-header,change-password,two-factor-auth}

CTDB=contacts
