# MailD deployment env file — the ONLY file an operator needs.
#
# Copy it to .env, edit the mandatory values, uncomment whatever you want to
# deviate from the defaults, and start the stack:
#     cp env.sample .env && $EDITOR .env
#     docker compose up -d
# (or let your CI craft .env from its own variables/secrets — see .gitlab-ci.yml)
#
# NEW SCHEMA: every tunable now defaults INSIDE each service image (ENV in the
# Dockerfiles, per service — only the variables that service consumes). This
# file carries the mandatory deployment values, the secrets, and any deviation
# from an image default: a same-named var here ALWAYS wins over the image
# default.
#
# RULES:
#   - Never leave a var EMPTY (an empty `FOO=` overrides the image default with
#     an empty string): comment the line out instead.
#   - Secrets are never baked into the images: they live in this file only.
#   - This file is injected ONLY into the 7 DB-consumer services (db, admin,
#     mua, mda, mta, amavis, cron); clamav needs no catalogue access (its knob
#     below is passed through by the compose files).
#   - The full default catalogue (what each image bakes, per service) lives in
#     .agents/services/configuration.md.

#############################################
# MANDATORY deployment values
#############################################
# The domain this server serves and the administrator's local part: the
# first-boot provisioner creates MAIL_ADMIN_USER@DEFAULT_DOMAIN as the
# PostfixAdmin superadmin, a real mailbox with the same password, and the
# default aliases pointing at it.
DEFAULT_DOMAIN=maild.cu
MAIL_ADMIN_USER=sysadmin

# PostgreSQL superuser password. CHANGE IT (openssl rand -hex 18). It bootstraps
# the db on a fresh volume and is used by every DB-consumer container.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-18

#############################################
# Secrets (optional)
#############################################
# Superadmin + administrator-mailbox password: MAIL_ADMIN_USER@DEFAULT_DOMAIN
# gets it for the mailbox AND the PostfixAdmin login. Left commented out it is
# generated and printed OTP-style in `docker compose logs admin`.
#MAIL_ADMIN_PASSWORD=change-me

# PostfixAdmin /setup.php setup password. NOTE: ignored — the admin entrypoint
# generates and prints its own OTP on every boot; documented for completeness.
#POSTFIXADMIN_SETUP_PASSWORD=change-me

# SnappyMail admin panel (https://webmail.<domain>/?admin). The login defaults
# to `maild`; left commented out the password is generated and printed OTP-style
# in `docker compose logs mua`. Set both to pin them.
#MUA_ADMIN_USER=maild
#MUA_ADMIN_PASSWORD=change-me

#############################################
# First-boot provisioning (see .agents/services/provisioning.md)
#############################################
# A fresh deploy provisions itself: db (catalogue + sentinel) -> admin (seeds
# DEFAULT_DOMAIN, the superadmin and the default aliases) -> amavis/mua/mta wait
# on the sentinel before their boot config. No /setup.php, no restarts.
#AUTO_PROVISION=yes         # 'no' restores the classic OTP + /setup.php flow
#PROVISION_VERSION=1        # bump to re-assert the defaults on the next boot
#PROVISION_WAIT_TIMEOUT=180 # seconds a gated service waits for the sentinel
#PROVISION_FORCE=no         # 'yes' re-writes the admin password on every boot

#############################################
# MTA (Postfix) — defaults baked in mta/Dockerfile
#############################################
#RELAY=                      # external relay host, format [1.2.3.4] for an IP
#ALWAYS_BCC=                 # background carbon copy, must be a valid address
#MAX_MESSAGESIZE=34865152    # ~25M: 1024 * 1024 * MB * 1.33
#SPF_ENABLE=True
#DNSBL_ENABLE=true
#DNSBL_LIST="zen.spamhaus.org=127.0.0.[2..11]*2,psbl.surriel.com,bl.spamcop.net,bl.spameatingmonkey.net"
#POSTMASTER_ABUSE_SETUP=true # point postmaster/abuse of each domain at the admin
#PEER_WAIT_TIMEOUT=120       # seconds the mta waits for amavis/mda to resolve
#PEER_WATCH_INTERVAL=30      # peer re-resolution loop; 0 disables the watchdog

#############################################
# MDA (Dovecot) — defaults baked in mda/Dockerfile
#############################################
#DEFAULT_MAILBOX_SIZE=200M
#QUOTA_REPORT_HOUR=0         # daily quota report, container (UTC) time
#QUOTA_REPORT_MINUTE=1
# Self-signed certificate subject (first boot only — NOT for production, no
# spaces): COUNTRY/STATE/CITY/ORG/OU all default in the mda image.

#############################################
# Webmail (SnappyMail) — defaults baked in mua/Dockerfile
#############################################
#BANNER_TITLE=Webmail
#MUA_PLUGINS=add-x-originating-ip-header,change-password,two-factor-auth
#MUA_CONFIG_WAIT_TIMEOUT=120 # seconds the entrypoint waits for SnappyMail's config

#############################################
# Content filtering (Amavis) — defaults baked in amavis/Dockerfile
#############################################
#AV_ENABLED=yes
#SPAM_FILTER_ENABLED=yes
#DKIM_SIGNING=yes
# SpamAssassin learning & maintenance (amavis + cron):
#JUNK_RETENTION_DAYS=7       # days to keep Junk before the cron purge (0 = off)
#SA_HAM_SAMPLE_PER_USER=25   # ham learning: random INBOX sample per mailbox
#SA_HAM_SAMPLE_MAX=400       # ...and the global cap per run
#SA_AUTOLEARN_NONSPAM=0.1    # bayes autolearn thresholds on normal scans
#SA_AUTOLEARN_SPAM=10
#SA_BAYES_PATH=/var/lib/spamassassin/bayes/db
#SA_UPDATE_HOUR=2           # sa-update daily run (amavis container, UTC)
#SA_UPDATE_MINUTE=50

#############################################
# ClamAV — passed through by the compose files (clamav gets no env_file)
#############################################
#ALTERNATE_MIRROR=clamav.ddns.net  # alternate signature mirror

#############################################
# Catalogue coordinates (advanced) — defaults baked in every DB-consumer image
#############################################
#POSTGRES_HOST=db
#POSTGRES_DB=mailddb
#POSTGRES_USER=maild
#POSTGRES_EXTRA_DB=contacts

#############################################
# Debug (all off by default)
#############################################
#DEBUG=true                  # mta: dumps the virtual-alias file at boot
#MTA_DEBUG=1
#MDA_DEBUG_INIT=1            # mda: container startup process
#MDA_DEBUG_AUTH=1            # mda: auth process
#MDA_DEBUG_AUTH_PASSWORD=1   # mda: password problems
#MDA_DEBUG_MAIL=1            # mda: mail delivery problems
#MDA_DEBUG_SSL=1             # mda: SSL problems (verbose_ssl is gone in Dovecot 2.4)
#MUA_DEBUG=1
#CLAMAV_DEBUG=1
#AMAVIS_DEBUG=1
