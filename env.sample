# Commented variables are meant to be loaded from the env [gitlab/github]
# this file must be dumped to .env on the deploy pipeline
#
# IMPORTANT: this file is used as base for production and local dev.

# enable debug, just keep this line, comment it to disable
DEBUG=false

#############################################
# Docker Image Configuration (CI/CD)
#############################################
# These are typically set in CI/CD pipeline (.gitlab-ci.yml)
# Uncomment and set if building/running locally
#IMG_DB=registry.example.com/maild/db
#IMG_ADMIN=registry.example.com/maild/admin
#IMG_MUA=registry.example.com/maild/mua
#IMG_MDA=registry.example.com/maild/mda
#IMG_MTA=registry.example.com/maild/mta
#IMG_CLAMAV=registry.example.com/maild/clamav
#IMG_AMAVIS=registry.example.com/maild/amavis
#IMG_CRON=registry.example.com/maild/cron
#TAG=latest

#############################################
# Domain & Mail Configuration
#############################################
DEFAULT_DOMAIN=maild.cu
MAIL_ADMIN_USER=sysadmin
DEFAULT_MAILBOX_SIZE=200M
MAX_MESSAGESIZE=34865152 # 25M (bytes: 1024 * 1024 * MB * 1.33)

# Superadmin + administrator mailbox password. The first-boot provisioner creates
# MAIL_ADMIN_USER@DEFAULT_DOMAIN in PostfixAdmin with this password, and the matching
# mailbox with the SAME password (so it is also a real IMAP account). Leave it empty to
# have a random one generated and printed OTP-style in `docker compose logs admin`.
#MAIL_ADMIN_PASSWORD=---

#############################################
# First-boot provisioning (see .agents/services/provisioning.md)
#############################################
# A fresh deploy provisions itself: the db container creates the catalogue + the
# maild_provision sentinel table, then the admin container seeds DEFAULT_DOMAIN, the
# superadmin (MAIL_ADMIN_USER@DEFAULT_DOMAIN) and the default aliases; amavis/mua/mta wait
# for the sentinel before they configure themselves (DKIM, SnappyMail per-domain configs,
# virtual aliases). No /setup.php, no down/up cycle, no per-service restart.
#
# Set to no to keep the classic manual flow (OTP + /setup.php + create domain by hand):
# useful on isolated networks or when you want full manual control.
AUTO_PROVISION=yes

# Bump this to re-assert the defaults (domain + admin mailbox + aliases) on the next boot.
# An existing password is never overwritten unless PROVISION_FORCE=yes.
PROVISION_VERSION=1

# Seconds a gated service (amavis/mua/mta) waits for the sentinel before giving up and
# booting anyway (a broken provisioner must not deadlock the stack).
#PROVISION_WAIT_TIMEOUT=180

# yes: re-write the administrator password from MAIL_ADMIN_PASSWORD on every boot.
#PROVISION_FORCE=no

#############################################
# Mailbox Quota Daily Report (MDA)
#############################################
# The mda container runs a background loop that mails the mail admin
# (MAIL_ADMIN_USER@DEFAULT_DOMAIN) a daily report of the mailboxes over a quota
# fill threshold, grouped per domain and in 5% slots, worst first: critical
# (over QUOTA_REPORT_CRITICAL%), then over 95%, 90%, 85% and 80%. Mailboxes
# under the threshold are not listed at all and the ones without a quota limit
# (unlimited) are never reported, only counted on the summary. The figures come
# from dovecot itself (doveadm quota get -A), so they are exactly what the quota
# plugin enforces, and only active mailboxes are seen.
#
# Force a report right away with:
#   docker compose exec mda /scripts/quota_report.sh --now
# and render one on screen without mailing it with:
#   docker compose exec mda /scripts/quota_report.sh --now --dry-run

# When to fire the daily report, in container local time (defaults: 0 and 1, so
# it goes out on the first minute past midnight). A container started later in
# the day fires it on the first tick after the start instead.
# Mind that the containers run UTC (no TZ is set anywhere in the stack), so this
# is UTC as well, the same convention the cron container's crontab follows.
#QUOTA_REPORT_HOUR=0
#QUOTA_REPORT_MINUTE=1

# Report the mailboxes over this fill percentage (default: 80)
#QUOTA_REPORT_THRESHOLD=80

# Fill percentage above which a mailbox is flagged as critical: it is on the
# verge of refusing mail (dovecot still allows a last delivery up to quota_grace,
# 10% over the limit, so 99% means "imminent", not "already refusing")
#QUOTA_REPORT_CRITICAL=99

# Set to yes to only mail the report when there is at least one mailbox over the
# threshold, instead of the daily "all clear" mail (default: no)
#QUOTA_REPORT_ONLY_WHEN_WARN=no

# Cap the mailboxes listed per domain and slot to keep the report short on a big
# server; 0 lists every offender (default: 0)
#QUOTA_REPORT_MAX_PER_SLOT=0

# Delivery attempts per day before giving up until tomorrow, so a broken
# delivery can't turn into a mail storm (default: 5)
#QUOTA_REPORT_MAX_ATTEMPTS=5

#############################################
# Database Configuration
#############################################
#POSTGRES_PASSWORD=---

# Extra databases, comma separated list. `db/` ensures they exist on EVERY boot,
# not only on first init (D-26), so a fresh install and an existing deployment
# behave the same. Default live value is in vars/db.env.
# contacts = SnappyMail address book (D-24)
#POSTGRES_EXTRA_DB=contacts

#############################################
# Database Backup (cron)
#############################################
# The cron container dumps POSTGRES_DB every day at 08:00 UTC (cron/crontab) into
# /backups/db/maild_backup_<date>.sql.gz, keeps 15 days of them and mails the result to
# MAIL_ADMIN_USER@DEFAULT_DOMAIN. Production binds /var/backups/maild to /backups, the dev
# stack binds ./ldata/backups — without a mount the dump lands in the container's writable
# layer and is lost on the next recreate.
#
# pg_dump must be >= the server major version (cron/Dockerfile builds it, db/Dockerfile pins
# the server): an older client aborts with "server version mismatch" and writes NOTHING on
# stdout, which is how a 20-byte archive got mailed as a successful backup for weeks. The
# script now checks that pair, reads pg_dump's own exit status (`set -o pipefail` +
# PIPESTATUS), logs its stderr, and validates the archive (minimum size, `gzip -t` and the
# "-- PostgreSQL database dump complete" trailer) before reporting SUCCESS. A dump that does
# not pass is deleted and mailed as [CRITICAL].
#
# Run one by hand with:
#   docker compose exec cron /scripts/backup_db.sh

# Compressed bytes below which an archive is not a backup (default: 1024; an empty dump
# compressed is ~20 bytes and a real mailddb dump is tens of KB)
#BACKUP_MIN_BYTES=1024

#############################################
# Daily Traffic Resume (cron)
#############################################
# The cron container runs the previous day's mail traffic through pflogsumm every day at
# 01:10 UTC (cron/crontab) and mails the report to MAIL_ADMIN_USER@DEFAULT_DOMAIN; on Sundays
# it appends the SpamAssassin/Bayes health (tokens learned, spam/ham balance and the age of
# the last sa-update run). Only Postfix' own log lines are summarised, selected by the MTA
# service name (MTA, from vars/amavis.env).
#
# The report is parsed out of /var/log/syslog and /var/log/syslog.1, so production needs BOTH
# the host /var/log bound into the cron container AND every service logging through Docker's
# syslog driver (docker-compose.yml -> logging): rsyslog on the host is what writes that file.
# Miss either one and the job still runs, still exits 0 and still mails a report -- with
# nothing in it but zeroes.
#
# The dev stack logs to JSON instead (DEV-SETUP.md -> Logging), so ./ldata/logs stays empty
# and there is no syslog to parse; test.sh phase G materialises one from `docker compose logs
# mta` to exercise the job for real, and removes it again on exit.
#
# Run one by hand with:
#   docker compose exec cron /scripts/resume.sh today   # today's traffic
#   docker compose exec cron /scripts/resume.sh         # yesterday's, exactly as cron does

#############################################
# Admin Interface Configuration
#############################################
#POSTFIXADMIN_SETUP_PASSWORD='---'

#############################################
# MTA (Postfix) Configuration
#############################################
# External relay host (if any), use format: [1.2.3.4] for IP
#RELAY=

# Background carbon copy - must be a valid email address
#ALWAYS_BCC=

# SPF checking (True/False)
SPF_ENABLE=True

# DNS-based Blackhole List configuration
DNSBL_ENABLE=true
DNSBL_LIST="zen.spamhaus.org=127.0.0.[2..11]*2,psbl.surriel.com,bl.spamcop.net,bl.spameatingmonkey.net"

# Point abuse and postmaster addresses to sysadmin (disabled by default)
#POSTMASTER_ABUSE_SETUP=true

#############################################
# Webmail (MUA) Configuration
#############################################
BANNER_TITLE=Webmail

#############################################
# Content Filtering (Amavis) Configuration
#############################################
# Enable spam filtering (yes/no)
SPAM_FILTER_ENABLED=yes

# Enable antivirus scanning (yes/no)
AV_ENABLED=yes

# Enable DKIM signing (yes/no)
DKIM_SIGNING=yes

#############################################
# ClamAV Configuration
#############################################
# Alternate mirror for updates
#ALTERNATE_MIRROR=clamav.ddns.net

#############################################
# SSL/TLS Certificate Configuration
#############################################
# For self-signed certificates (initial deployment only - NOT FOR PRODUCTION)
# DO NOT USE SPACES
COUNTRY=JM
STATE=Kingston
CITY=Kingston
ORG=MailD
OU=MailD

#############################################
# Debug Options (comment to disable)
#############################################
#MTA_DEBUG=1
#MDA_DEBUG_INIT=1         # container startup process
#MDA_DEBUG_AUTH=1         # auth process
#MDA_DEBUG_AUTH_PASSWORD=1 # password problems
#MDA_DEBUG_MAIL=1         # mail delivery problems
#MDA_DEBUG_SSL=1          # SSL problems
#MUA_DEBUG=1
#CLAMAV_DEBUG=1
#AMAVIS_DEBUG=1
