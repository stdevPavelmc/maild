# MailD deployment env file — the ONLY file an operator needs.
#
# Copy it to .env, edit the mandatory values, uncomment whatever you want to
# deviate from the defaults, and start the stack:
#     cp env.sample .env && $EDITOR .env
#     docker compose up -d
# (or let your CI craft .env from its own variables/secrets — see .gitlab-ci.yml)
#
# NEW SCHEMA: every tunable now defaults INSIDE each service image (ENV in the
# Dockerfiles, per service — only the variables that service consumes). This
# file carries the mandatory deployment values, the secrets, and any deviation
# from an image default: a same-named var here ALWAYS wins over the image
# default.
#
# RULES:
#   - Never leave a var EMPTY (an empty `FOO=` overrides the image default with
#     an empty string): comment the line out instead.
#   - Secrets are never baked into the images: they live in this file only.
#   - This file is injected ONLY into the 7 DB-consumer services (db,
#     api, mua, mda, mta, amavis, cron); clamav needs no catalogue access (its
#     knob below is passed through by the compose files). The mcp container
#     never gets this file: the compose files pass it an explicit allow-list of
#     the MCP_* variables below (it must never see POSTGRES_PASSWORD).
#   - The full default catalogue (what each image bakes, per service) lives in
#     .agents/services/configuration.md.

#############################################
# MANDATORY deployment values
#############################################
# The domain this server serves and the administrator's local part: the
# first-boot provisioner creates MAIL_ADMIN_USER@DEFAULT_DOMAIN as the
# PostfixAdmin superadmin, a real mailbox with the same password, and the
# default aliases pointing at it.
DEFAULT_DOMAIN=maild.cu
MAIL_ADMIN_USER=sysadmin

# PostgreSQL superuser password. CHANGE IT (openssl rand -hex 18). It bootstraps
# the db on a fresh volume and is used by every DB-consumer container.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-18

# AdminNG JWT signing + TOTP-secret encryption key. CHANGE IT (openssl rand -hex 32).
# The variable is mandatory (compose refuses to start without it), but this shipped
# value is public: while it stays here the API logs a warning and anyone who reads
# this file could mint administrator tokens.
# Rotating it invalidates live sessions and enrolled TOTP seeds (admins re-enroll).
ADMINNG_SECRET_KEY=change-me-openssl-rand-hex-32

# MailD MCP (AI-assistant access to the mailboxes, https://mcp.<domain>). The three
# are mandatory (compose refuses to start without them). CHANGE THEM.
#   MCP_DB_PASSWORD   password of the restricted db role the mcp connects as
#                     (MCP_DB_USER, default maild_mcp; db re-asserts it on every boot)
#   MCP_SECRET_KEY    signs the MCP web sessions/tokens (openssl rand -hex 32)
#   MCP_DOVECOT_MASTER_PASSWORD  Dovecot master user the mcp opens mailboxes with
#                     (IMAP only, read by mda AND mcp; rotating = edit + recreate both)
MCP_DB_PASSWORD=change-me-openssl-rand-hex-18
MCP_SECRET_KEY=change-me-openssl-rand-hex-32
MCP_DOVECOT_MASTER_PASSWORD=change-me-openssl-rand-hex-18

#############################################
# Secrets (optional)
#############################################
# Superadmin + administrator-mailbox password: MAIL_ADMIN_USER@DEFAULT_DOMAIN
# gets it for the mailbox AND the AdminNG superadmin login. Left commented out it
# is generated and printed OTP-style in `docker compose logs api`.
#MAIL_ADMIN_PASSWORD=change-me

# SnappyMail admin panel (https://webmail.<domain>/?admin). The login defaults
# to `maild`; left commented out the password is generated and printed OTP-style
# in `docker compose logs mua`. Set both to pin them.
#MUA_ADMIN_USER=maild
#MUA_ADMIN_PASSWORD=change-me

#############################################
# First-boot provisioning (see .agents/services/provisioning.md)
#############################################
# A fresh deploy provisions itself: db creates the catalogue schema + sentinel ->
# api seeds DEFAULT_DOMAIN, the superadmin, its mailbox and the default aliases and
# writes the sentinel -> amavis/mua/mta wait on the sentinel before their boot
# config. No setup wizard, no restarts.
#AUTO_PROVISION=yes         # 'no' = boot seeder off; seed by hand with
#                           #       `docker compose exec api adminng.py --provision`
#PROVISION_VERSION=1        # bump to re-assert the defaults on the next boot
#PROVISION_WAIT_TIMEOUT=180 # seconds a gated service waits for the sentinel
#PROVISION_FORCE=no         # 'yes' re-writes the admin password on every boot

#############################################
# Password hashing — shared by api/mua (2026-10 audit F-18)
#############################################
# Scheme for NEW mailbox/administrator password hashes, written by every
# MailD writer (the api seeder on first boot, the AdminNG API, the webmail
# change-password driver):
#   argon2id (default) — '{ARGON2ID}$argon2id$…', memory-hard, verified by
#                        Dovecot's {SCHEME} dispatch.
#   md5crypt           — legacy raw '$1$…', the PostfixAdmin-compatible escape
#                        hatch. WEAK-SCHEME SUPPORT IS REMOVED STACK-WIDE ON
#                        **2027-02-01**: from that date the api refuses to boot
#                        with it, the mda sets auth_allow_weak_schemes=no and
#                        legacy $1$ hashes stop authenticating. Existing legacy
#                        rows migrate on password change or on their next
#                        IMAP/POP3 login (rehash-on-login).
#PASSWORD_SCHEME=argon2id

#############################################
# MTA (Postfix) — defaults baked in mta/Dockerfile
#############################################
#RELAY=                      # external relay host, format [1.2.3.4] for an IP
#ALWAYS_BCC=                 # background carbon copy, must be a valid address
#MAX_MESSAGESIZE=34865152    # ~25M: 1024 * 1024 * MB * 1.33
#SPF_ENABLE=True
#DNSBL_ENABLE=true
#DNSBL_LIST="zen.spamhaus.org=127.0.0.[2..11]*2,psbl.surriel.com,bl.spamcop.net,bl.spameatingmonkey.net"
# F-07 tarpit: seconds the mta sleeps before the 550 for unknown local parts on :25
# (0 = off). Slows address harvesting; every external RCPT addressed to your own
# domains pays the delay (submission/smtps are unaffected).
#SMTP_TARPIT_DELAY=2
#POSTMASTER_ABUSE_SETUP=true # point postmaster/abuse of each domain at the admin
#PEER_WAIT_TIMEOUT=120       # seconds the mta waits for amavis/mda to resolve
#PEER_WATCH_INTERVAL=30      # peer re-resolution loop of the mta AND amavis (its listener
                             # ACLs); 0 disables both watchdogs
#AMAVIS_SUBMIT_PORT=10026    # cron: amavis listener the report mails use (10024 = mta only)
# Per-user outbound throttle on submission/smtps 587/465 (audit F-12): envelope
# recipients per authenticated user per window; past the limit the RCPT is
# deferred (450) and retried. 0 disables the throttle (and its daemon).
#OUTBOUND_RATE_RECIPIENTS=200
#OUTBOUND_RATE_WINDOW=3600
# Hard bypass for notification senders: exact account addresses, comma-separated,
# never throttled from any IP (the cron alert job has its own ignore twin below).
#OUTBOUND_RATE_EXEMPT_USERS=no-reply@example.org,sysadmin@example.org

#############################################
# MDA (Dovecot) — defaults baked in mda/Dockerfile
#############################################
#DEFAULT_MAILBOX_SIZE=200M
#QUOTA_REPORT_HOUR=0         # daily quota report, container (UTC) time
#QUOTA_REPORT_MINUTE=1
# Self-signed certificate subject (first boot only — NOT for production, no
# spaces): COUNTRY/STATE/CITY/ORG/OU all default in the mda image.

#############################################
# Webmail (SnappyMail) — defaults baked in mua/Dockerfile
#############################################
#BANNER_TITLE=Webmail
#MUA_PLUGINS=add-x-originating-ip-header,change-password,two-factor-auth
#MUA_CONFIG_WAIT_TIMEOUT=120 # seconds the entrypoint waits for SnappyMail's config

#############################################
# Content filtering (Amavis) — defaults baked in amavis/Dockerfile
#############################################
#AV_ENABLED=yes
#SPAM_FILTER_ENABLED=yes
#DKIM_SIGNING=yes
# SpamAssassin learning & maintenance (amavis + cron):
#JUNK_RETENTION_DAYS=7       # days to keep Junk before the cron purge (0 = off)
#SA_HAM_SAMPLE_PER_USER=25   # ham learning: random INBOX sample per mailbox
#SA_HAM_SAMPLE_MAX=400       # ...and the global cap per run
#SA_AUTOLEARN_NONSPAM=0.1    # bayes autolearn thresholds on normal scans
#SA_AUTOLEARN_SPAM=10
#SA_BAYES_PATH=/var/lib/spamassassin/bayes/db
#SA_UPDATE_HOUR=2           # sa-update daily run (amavis container, UTC)
#SA_UPDATE_MINUTE=50
# Outbound volume watch (cron job, hourly; needs the production syslog like the
# daily resume): alerts the admin when a user crosses the daily threshold or the
# mta's per-user rate limit engaged. Alert-side twin of OUTBOUND_RATE_EXEMPT_USERS.
#OUTBOUND_ALERT_MESSAGES=150  # per-user/day message alert threshold (0 = off)
#OUTBOUND_ALERT_IGNORE_USERS= # accounts never alerted on (comma-separated)

#############################################
# DNS health check (cron job, daily 04:20 UTC) — defaults baked in cron/Dockerfile
#############################################
# Verifies what the outside world sees for every active domain (MX, SPF, DMARC, DKIM
# against the keys Amavis really signs with, PTR/FCrDNS, MTA-STS/TLS-RPT when
# published, blocklists) and mails the deviations to postmaster@DEFAULT_DOMAIN.
# Silent when everything is fine.
# The MX targets that belong to THIS deployment. Unset = inferred from
# DEFAULT_DOMAIN's live MX (a notice is added and the MX mismatch drops to a warning,
# so a wrong but consistent change cannot validate itself).
#MX_HOSTNAME=mta.example.org
#DNS_CHECK_TO=postmaster@example.org # report recipient (default postmaster@DEFAULT_DOMAIN)
#DNS_CHECK_ALERT_LEVEL=warning   # critical | warning | notice — what gets mailed
#DNS_CHECK_RESOLVER=             # resolver IP for every query. Point it at your own
                                 # recursive resolver: the free Spamhaus zones refuse
                                 # public resolvers (127.255.255.x) and look "clean".
#DNS_CHECK_BLOCKLISTS=multi.surbl.org      # domain blocklist zones (comma list)
#DNS_CHECK_IP_BLOCKLISTS=zen.spamhaus.org  # IP blocklist zones (comma list)
#DNS_CHECK_DKIM=auto             # auto (compare against the Amavis keys) | no
#DNS_CHECK_SPF_MX_COVERAGE=warning # warning | notice | off ("MX IPs not covered by SPF")
#DNS_CHECK_TIMEOUT=10            # seconds per DNS query
#DNS_CHECK_DOMAINS=              # replace the catalogue list (comma list; 'none' = off)

#############################################
# ClamAV — passed through by the compose files (clamav gets no env_file)
#############################################
#ALTERNATE_MIRROR=clamav.ddns.net  # alternate signature mirror

#############################################
# AdminNG (next-generation admin UI / PWA) — defaults baked in adminng/api
#############################################
# The PWA (`adminng`) is static + a proxy and takes no env. The API (`api`)
# defaults are baked in its image; override here when needed. See
# adminng/doc/technical-draft.md §2.4.
#ADMINNG_ACCESS_TTL=600          # access-token lifetime, seconds
#ADMINNG_REFRESH_IDLE_TTL=900    # refresh-token idle purge (the 15-min rule)
#ADMINNG_REMEMBER_TTL=86400      # access + refresh idle lifetime for remembered devices (24 h)
#ADMINNG_REAUTH_TTL=30           # destructive-action validation token lifetime
#ADMINNG_TOTP_REQUIRED=superadmin # 'all' | 'superadmin' | 'none'
#ADMINNG_SEARCH_LIMIT=20         # rapid-search results per entity type
#ADMINNG_QUOTA_CACHE_TTL=300     # quota-usage cache, seconds
#ADMINNG_API_DOCS=no             # 'yes' = serve /api/v1/openapi.json + Swagger UI
                                 # (dev convenience only; keep it off in production)
#ADMINNG_AUTO_APPROVE_FIRST=no   # 'yes' = first superadmin login auto-approves its
                                 # device (unattended first boot; see adminng/README.md)
#ADMINNG_PENDING_TTL_DAYS=3      # purge PENDING device grants older than N days (0 = off)
#ADMINNG_TOTP_ISSUER=MailD AdminNG
#ADMINNG_LOGIN_MAX_FAILURES=5    # failed logins before the lockout
#ADMINNG_LOCKOUT_SECONDS=900     # lockout duration
#ADMINNG_WEBAUTHN_RP_ID=adminng.example.com # DNS RP ID; production requires HTTPS
#ADMINNG_WEBAUTHN_ORIGINS=https://adminng.example.com # exact comma-separated origins
#ADMINNG_WEBAUTHN_CHALLENGE_TTL=300 # one-use WebAuthn challenge lifetime, seconds

#############################################
# MailD MCP (optional) — defaults baked in the mcp image
#############################################
#MCP_HOSTNAME=mcp.example.com   # public host (Traefik rule, allowed host); default mcp.<DEFAULT_DOMAIN>
#MCP_PUBLIC_URL=https://mcp.example.com  # base of the links in service mail (magic links); default https://<MCP_HOSTNAME>
#MCP_TRUSTED_PROXIES=172.18.0.0/16       # CIDRs whose X-Forwarded-For is believed (set it to the `maild`
                                         # network your ingress shares, or lockouts/audit see only the proxy IP)
#MCP_SMTP_HOST=amavis           # service mail submission (no auth, DKIM-signed by amavis)
#MCP_SMTP_PORT=10026           # amavis INTERNAL listener (10024 admits only the mta)
#MCP_ACCESS_TTL=15m             # web access token lifetime (the refresh cookie rotates it)
#MCP_USER_SESSION_TTL=24h       # absolute user web-session lifetime
#MCP_ADMIN_USER=admin           # /adminmcp admin, FIRST BOOT ONLY (ignored once it exists)
#MCP_ADMIN_PASSWORD=change-me   # first boot only; commented out = generated, printed in `docker compose logs mcp`
#MCP_ADMIN_EMAIL=sysadmin@example.com  # first boot only; default <MAIL_ADMIN_USER>@<DEFAULT_DOMAIN>
#MCP_SERVICE_EMAIL=mcp@example.com     # sender of the MCP service mail; the mailbox is created at
                                       # boot when missing, default mcp@<DEFAULT_DOMAIN>
#MCP_SERVICE_PASSWORD=change-me # only used when that mailbox is created; commented out = generated, printed once
#MCP_DOVECOT_MASTER_USER=mcp    # master login name (read by mda and mcp)
#MCP_DB=mcp                     # the MCP's own database (read by db and mcp)
#MCP_DB_USER=maild_mcp          # its role (read by db and mcp)
#MCP_WORKERS=2                  # uvicorn worker processes
#MCP_DEBUG=1                    # debug logging (never in production)

#############################################
# Catalogue coordinates (advanced) — defaults baked in every DB-consumer image
#############################################
#POSTGRES_HOST=db
#POSTGRES_DB=mailddb
#POSTGRES_USER=maild
#POSTGRES_EXTRA_DB=contacts  # extra DBs created by db (comma list); the mua reads
                             # this as ONE name for its contacts DSN — leave as is
#ADMINNG_DB=adminng         # AdminNG's own database (db creates it; must match api)

#############################################
# Debug (all off by default)
#############################################
#DEBUG=true                  # mta: dumps the virtual-alias file at boot
#MTA_DEBUG=1
#MDA_DEBUG_INIT=1            # mda: container startup process
#MDA_DEBUG_AUTH=1            # mda: auth process
#MDA_DEBUG_AUTH_PASSWORD=1   # mda: password problems
#MDA_DEBUG_MAIL=1            # mda: mail delivery problems
#MDA_DEBUG_SSL=1             # mda: SSL problems (verbose_ssl is gone in Dovecot 2.4)
#MUA_DEBUG=1
#CLAMAV_DEBUG=1
#AMAVIS_DEBUG=1
