# MailD deployment env file — GitLab CI variant.
#
# The deploy pipeline crafts .env from this template plus the CI/CD variables
# (see .gitlab-ci.yml): the mandatory values and the secrets come from the
# project's CI/CD settings (masked variables), everything else is an optional
# deviation from an image default — same rules as env.sample.
#
# NEW SCHEMA: every tunable defaults INSIDE each service image (ENV in the
# Dockerfiles, per service); a same-named var in the crafted .env ALWAYS wins
# over the image default. Never leave a var empty — comment it out instead.
# Full default catalogue: .agents/services/configuration.md.

#############################################
# MANDATORY deployment values (from the CI/CD variables)
#############################################
#DEFAULT_DOMAIN=
#MAIL_ADMIN_USER=sysadmin
#POSTGRES_PASSWORD=

#############################################
# Secrets (optional, from the CI/CD variables)
#############################################
#MAIL_ADMIN_PASSWORD=
#MUA_ADMIN_USER=maild
#MUA_ADMIN_PASSWORD=

#############################################
# First-boot provisioning
#############################################
#AUTO_PROVISION=yes
#PROVISION_VERSION=1
#PROVISION_WAIT_TIMEOUT=180
#PROVISION_FORCE=no

#############################################
# Content filtering (default: all on, baked in the amavis image)
#############################################
#AV_ENABLED=yes
#SPAM_FILTER_ENABLED=yes
#DKIM_SIGNING=yes

#############################################
# Anything else: see env.sample (the full commented catalogue)
#############################################
