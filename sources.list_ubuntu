# if you publish the repos on localhost and your are using docker then
# by default on debian/ubuntu the ip 192.168.1.102 is "localhost" from the
# docker containers
#
# if on the net, adjust it as needed.

Types: deb
URIs: http://192.168.1.102/ubuntu
Suites: noble noble-updates noble-security
Components: main universe multiverse restricted
Architectures: amd64
# Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Trusted: yes
