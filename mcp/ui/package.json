{
  "name": "maild-mcp-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MailD MCP user page (React SPA, same stack as the AdminNG PWA)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "build": "npm run i18n:check && tsc --noEmit && vite build"
  },
  "dependencies": {
    "altcha": "2.3.0",
    "clsx": "2.1.1",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "6.4.6"
  }
}
