# env.dev — the DEV operator env file: compose interpolation file AND the
# containers' env_file for docker-compose-dev.yml (DEV ONLY).
#
# Contains FAKE, random, dev-only secrets — safe to commit, unlike .env which holds
# the real local/production passwords and is NEVER read by the dev stack.
# Usage: docker compose --env-file env.dev -f docker-compose-dev.yml <cmd>
# (bootstrap-dev.sh passes the flag for you; use it in manual commands too,
#  otherwise compose interpolates from .env and the db password would drift.)
#
# Env schema: every tunable now defaults INSIDE each service image (ENV in the
# Dockerfiles, per service); this file carries only the deployment values
# (domain, admin user, fake secrets) and any deviation from an image default —
# a same-named var here always wins over the image default. env.sample is the
# template for the production .env (same rules).

DEFAULT_DOMAIN=maild.cu
MAIL_ADMIN_USER=sysadmin
DEFAULT_MAILBOX_SIZE=200M

# Fake random secrets (regenerate with: openssl rand -hex 18)
# POSTFIXADMIN_SETUP_PASSWORD is ignored by the admin entrypoint (it emits an OTP
# on every boot and overwrites whatever is here); kept for parity with the
# documented production catalogue in env.sample.
POSTGRES_PASSWORD=964963a91660c4ce22c28cfd4376af24d12e
# Fake dev secret (NOT the production key): signs AdminNG JWTs and encrypts TOTP
# seeds. Real deployments generate their own with `openssl rand -hex 32`.
ADMINNG_SECRET_KEY=1f0cbb6e5de6b0e8f6f5e2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6e5f4a3b
POSTFIXADMIN_SETUP_PASSWORD=197031ec1db7cf11e039605f4583195a

# Content filtering, ON in dev so the EICAR / GTUBE / banned-attachment tests in
# test.sh always run (the compose shim defaults them to no; the amavis image
# defaults them to yes, so production keeps them on unless you override them):
#   - AV needs ClamAV's signature database: the first boot downloads ~230 MB at
#     ~5 Mb/s. bootstrap-dev.sh waits for it before declaring the stack ready,
#     and amavis defers mail until clamd answers, so do not expect mail to flow
#     on a cold volume before that download finishes.
#   - SpamAssassin rules ship inside the image (no download needed).
AV_ENABLED=yes
SPAM_FILTER_ENABLED=yes

# Deviation from an image default, on purpose: BANNER_TITLE defaults to "Webmail"
# inside the mua image; this override proves (and test.sh asserts) that a
# same-named var in the env file wins over the image ENV default.
BANNER_TITLE=MailD Dev Override
