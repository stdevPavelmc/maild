# env.dev — the DEV operator env file: compose interpolation file AND the
# containers' env_file for docker-compose-dev.yml (DEV ONLY).
#
# Contains FAKE, random, dev-only secrets — safe to commit, unlike .env which holds
# the real local/production passwords and is NEVER read by the dev stack.
# Usage: docker compose --env-file env.dev -f docker-compose-dev.yml <cmd>
# (bootstrap-dev.sh passes the flag for you; use it in manual commands too,
#  otherwise compose interpolates from .env and the db password would drift.)
#
# Env schema: every tunable now defaults INSIDE each service image (ENV in the
# Dockerfiles, per service); this file carries only the deployment values
# (domain, admin user, fake secrets) and any deviation from an image default —
# a same-named var here always wins over the image default. env.sample is the
# template for the production .env (same rules).

DEFAULT_DOMAIN=maild.cu
MAIL_ADMIN_USER=sysadmin
DEFAULT_MAILBOX_SIZE=200M

# Fake random secrets (regenerate with: openssl rand -hex 18)
# POSTFIXADMIN_SETUP_PASSWORD is ignored by the admin entrypoint (it emits an OTP
# on every boot and overwrites whatever is here); kept for parity with the
# documented production catalogue in env.sample.
POSTGRES_PASSWORD=964963a91660c4ce22c28cfd4376af24d12e
# Fake dev secret (NOT the production key): signs AdminNG JWTs and encrypts TOTP
# seeds. Real deployments generate their own with `openssl rand -hex 32`.
ADMINNG_SECRET_KEY=1f0cbb6e5de6b0e8f6f5e2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6e5f4a3b
# Deviation from the api image default (no): keep the OpenAPI contract + Swagger UI
# reachable on the dev stack. Production .env leaves it off (2026-10 audit F-04).
ADMINNG_API_DOCS=yes
# ADMINNG_TRUSTED_PROXIES is left unset on purpose: the dev stack runs the
# production default (the attached subnets minus the docker gateway). The test
# host reaches nginx through the gateway (172.23.0.1), which is never believed,
# so test.sh I16b/I16c exercise exactly the trust rule production ships.
POSTFIXADMIN_SETUP_PASSWORD=197031ec1db7cf11e039605f4583195a

# Content filtering, ON in dev so the EICAR / GTUBE / banned-attachment tests in
# test.sh always run (the compose shim defaults them to no; the amavis image
# defaults them to yes, so production keeps them on unless you override them):
#   - AV needs ClamAV's signature database: the first boot downloads ~230 MB at
#     ~5 Mb/s. bootstrap-dev.sh waits for it before declaring the stack ready,
#     and amavis defers mail until clamd answers, so do not expect mail to flow
#     on a cold volume before that download finishes.
#   - SpamAssassin rules ship inside the image (no download needed).
AV_ENABLED=yes
SPAM_FILTER_ENABLED=yes

# Deviation from an image default, on purpose: BANNER_TITLE defaults to "Webmail"
# inside the mua image; this override proves (and test.sh asserts) that a
# same-named var in the env file wins over the image ENV default.
BANNER_TITLE=MailD Dev Override

# F-12 dev fixture: the per-user outbound throttle exempts the admin account, so
# test.sh can assert both branches (a synthetic user gets throttled, this one
# bypasses the limit). Must match MAIL_ADMIN_USER + DEFAULT_DOMAIN above.
OUTBOUND_RATE_EXEMPT_USERS=sysadmin@maild.cu
# The throttle limit stays at the image default (200 recipients/user/hour): the
# suite submits ~19 authenticated messages as the admin account, so a tiny limit
# would throttle the suite's own traffic. The throttle logic itself is asserted
# in test.sh (A14 wiring + A15/A16 direct policy-protocol probes with a
# synthetic user), so it does not need a small limit here.

# DNS health check (cron, daily 04:20): the MX targets that belong to this
# deployment, i.e. `hostname -f` inside the mta container. The dev domains are
# fictitious (maild.cu is not delegated anywhere), so the daily check WILL report
# problems on a dev box — that is expected. Silence it with `DNS_CHECK_DOMAINS=none`
# for a quiet box, or probe only what really exists: `DNS_CHECK_DOMAINS=example.com`.
MX_HOSTNAME=mta.maild.cu

# MailD MCP (mcp/technical-proposal.md §9.5) — fake dev-only secrets.
# MCP_DB_PASSWORD     db role maild_mcp (db/ensure_roles.sh) + the mcp container
# MCP_SECRET_KEY      JWT/token/ALTCHA HMAC + Fernet derivation (openssl rand -hex 32)
# MCP_DOVECOT_MASTER_PASSWORD  Dovecot master user, read by mda (enables it) and mcp
MCP_DB_PASSWORD=4df86e91e2bf5b0a81c6c2c490102e3facfc
MCP_SECRET_KEY=b1b68662387291aa9292bc114389c00794a639f514e407fc3be7cbcc56173dec
MCP_DOVECOT_MASTER_PASSWORD=ef3ba936b6e53cd1eb4a06be8113d2769f59

# mua — Roundcube webmail (mua/README.md) — fake dev-only secret.
# ROUNDCUBE_DB_PASSWORD  db role maild_roundcube (db/ensure_roles.sh: owner of the roundcube
#                        database, directory reads + password column on the catalogue)
ROUNDCUBE_DB_PASSWORD=7c41d0a9e35b28f61e04bd9a3c7f582e6d10
# dev: Spanish on purpose, to exercise ROUNDCUBE_LANGUAGE (the image default is en_US)
ROUNDCUBE_LANGUAGE=es_ES
