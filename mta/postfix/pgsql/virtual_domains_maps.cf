user = _POSTGRES_USER_
password = _POSTGRES_PASSWORD_
hosts = _POSTGRES_HOST_
dbname = _POSTGRES_DB_
query = SELECT d.domain FROM domain d WHERE d.domain='%s' AND d.active = true AND NOT EXISTS (SELECT 1 FROM alias_domain ad WHERE ad.alias_domain = d.domain AND ad.active = true)
#optional query to use when relaying for backup MX
#query = SELECT domain FROM domain WHERE domain='%s' and backupmx = false and active = true